GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_PROSE_MODEL=openai/gpt-oss-20b

# Required for admin sign-in in every environment. Generate a random session secret of at least 32 characters.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional persistent directory for server-side sessions.
# ADMIN_SESSION_DIR=/var/lib/petitionpro/admin-sessions

# Consultant inquiry emails (Resend; use a verified sender address).
RESEND_API_KEY=
INQUIRY_EMAIL_FROM=
INQUIRY_EMAIL_TO=
# Public origin, used for admin-inbox links in notification emails.
APP_URL=http://localhost:3040
# Private persistent directories; defaults are under .data/.
# INQUIRY_STORAGE_DIR=/var/lib/petitionpro/inquiries
# PUBLIC_LIMIT_DIR=/var/lib/petitionpro/public-limits

# Shared inquiry database and private CV storage (server only).
# Apply supabase/migrations/202611020001_petitionpro_inquiries.sql first.
SUPABASE_URL=https://cvlrhumxbyakxqzhenuw.supabase.co
SUPABASE_SECRET_KEY=
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
